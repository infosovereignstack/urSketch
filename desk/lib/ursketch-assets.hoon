rid;grid-template-columns:minmax(0,1fr) auto;gap:4px;padding:9px 5px;border-radius:3px;align-items:center}.players li.me{background:#eaf0df}.player-name{font-size:11px;font-weight:600;overflow-wrap:anywhere;min-width:0}.player-role{display:block;font-size:9px;font-weight:400;color:var(--muted);margin-top:3px}.player-score{font:12px monospace}.game-log,.chat{display:flex;flex-direction:column}.message-log{overflow-y:auto;overflow-wrap:anywhere;flex:1;min-height:0;padding:9px 10px;background:#ffffee;font-size:11px;line-height:1.5}.chat{grid-area:2/1}.chat .message-log{background:#fffef9}.message{margin:0 0 7px}.message b{font-weight:600;font-size:10px;margin-right:5px;color:#477846}.message.system{color:#9d5b34;font-size:10px}.message.correct{color:#23803b}.message.answer{color:#ad4138;font-weight:600}.message.guess{color:#273831}.message.chat{display:block;border:0;border-radius:0;overflow:visible;min-height:0;min-width:0}.game-log form,.chat form{display:flex;position:relative;flex:none;margin:5px}#guess,#chat-input{width:100%;padding:9px 32px 9px 8px;font-size:11px;height:33px}.game-log form button,.chat form button{position:absolute;right:3px;top:3px;padding:3px 8px;height:27px;background:var(--green);color:white}\0a.studio{grid-area:1/2/3/3;display:flex;flex-direction:column;background:#fff}#tools{display:flex;align-items:center;justify-content:flex-end;gap:14px;flex:none;min-height:66px;padding:7px 10px;border-bottom:1px solid var(--line);background:#eef0e7}.palette{display:grid;grid-template-columns:repeat(8,16px);grid-template-rows:repeat(3,14px);gap:2px;padding:3px;border:1px solid #b6bdaf;background:#d8dfd1;flex:none}.swatch{border-radius:0;padding:0;width:16px;height:14px;border:1px solid #ffffffb0;box-shadow:0 0 0 1px #7a8473}.swatch.selected{outline:2px solid #253e34;outline-offset:1px;z-index:1}.stroke-control{display:grid;grid-template-columns:32px 120px;grid-template-rows:17px 27px;gap:0 7px;align-items:center;flex:none}#brush-preview{grid-column:1;gri
:0;padding:0;font-size:11px;line-height:14px;grid-area:auto}\0abody.playing[data-layout=classic].large-chat .message{font-size:13px;line-height:16px}\0abody.playing[data-layout=classic] .panel-label button{display:inline;border:0;background:none;padding:0;color:inherit;font:inherit;line-height:inherit;height:14px;box-shadow:none}\0abody.playing[data-layout=classic] .panel-label button:focus-visible{outline:1px dotted #000}\0a\0abody.playing[data-layout=classic] :is(#guess,#chat-input){background:#fff}\0abody.playing[data-layout=classic][data-active-chat=game] #guess,body.playing[data-layout=classic][data-active-chat=chat] #chat-input{background:#ffffdc}\0a/* The canvas fills the drawing panel; every visible edge accepts strokes. */\0abody.playing[data-layout=classic] .canvas-wrap{background:#fff}\0abody.playing[data-layout=classic] #canvas{background:#fff;outline:1px solid #999}\0a\0a\0abody[data-layout=classic] #create-form #create-error{color:#b00020}\0abody.playing[data-layout=classic] .room-notice{display:flex;align-items:center;justify-content:space-between;gap:10px;flex:none;padding:3px 6px;min-height:25px;font:11px/16px Verdana,Arial,sans-serif;color:#000}\0abody.playing[data-layout=classic] .room-notice button{padding:2px 12px;font:11px Verdana,Arial,sans-serif}\0abody.playing[data-theme=blingee] .room-notice{color:#fff}\0a#artist-banner{position:absolute;left:var(--board-left,0);top:var(--board-top,0);width:var(--board-width,100%);background:#ffffa0;color:#000;text-align:center;font:bold clamp(10px,1.3vw,18px)/1.35 Verdana,Arial,sans-serif;padding:4px 8px;pointer-events:none;z-index:2}\0abody.playing[data-layout=classic] .message:is(.announcement,.found-word,.reward,.artist-word,.round,.round-result){color:#f00}\0abody.playing[data-layout=classic] .message strong{font-weight:bold}\0abody.playing[data-layout=classic]:not(.is-artist) #guess-form{display:flex}\0a\0a/* Finale art follows the reference: red-lit white captions and gold WordArt. */\0a#game-finale{position:absolute;inset:0;z-index:3;background:#000;overflow:hidden;pointer-events:none;container-type:inline-size}\0a#game-finale>canvas{position:absolute;inset:0;width:100%;height:100%;max-width:none;max-height:none;outline:0;cursor:default}\0a.finale-wordart{position:absolute;inset:6% 3% auto;text-align:center;font-family:Arial,Helvetica,sans-serif;font-weight:900;line-height:1.15}\0a.finale-caption{color:#fff;font-size:clamp(15px,5.2cqw,34px);text-shadow:0 0 3px #f22,0 0 9px #d11,2px 2px 1px #6b0000}\0a.finale-winner{margin:5% 0 7%;font-size:clamp(26px,9.8cqw,68px);line-height:1.1;overflow-wrap:anywhere;background:linear-gradient(#fff 8%,#fff7a5 28%,#9c7310 45%,#fff 52%,#fff9ad 67%,#d0a930 88%,#fff 96%);background-clip:text;-webkit-background-clip:text;color:transparent;filter:drop-shadow(2px 3px 1px #785b1a) drop-shadow(0 0 4px #d5c687);transform:perspective(500px) rotateX(8deg)}\0a.finale-winner.long-name{font-size:clamp(22px,7.2cqw,50px)}\0abody.playing[data-layout=classic] .message.game-result{color:#f00;font-weight:bold}\0abody.playing[data-layout=classic] .timer-dial.blank{background:none!important;box-shadow:none;--sweep:0deg}\0a.timer-dial.blank::before,.timer-dial.blank::after{display:none}\0a\0a/* One live selection; icon art contains no preselected button background. */\0abody.playing[data-layout=classic] #tool-grid button{display:grid;place-items:center;width:21px;height:22px;min-width:0;min-height:0;padding:1px;border:1px outset #eee;border-radius:0;background:#d5d5d5;box-shadow:none;outline:none;filter:none;overflow:hidden}\0abody.playing[data-layout=classic] #tool-grid button svg,body.playing[data-layout=classic] #tool-grid svg.outline{visibility:visible;width:17px;height:18px;display:block;margin:0;pointer-events:none}\0abody.playing[data-layout=classic] #tool-grid button[aria-pressed=true]{border:1px inset #555;background:#aebfd1;box-shadow:inset 0 0 0 1px #728496}\0abody.playing[data-layout=classic] #tool-grid button:focus-visible{outline:1px dotted #222;outline-offset:-3px}\0abody.playing[data-theme=blingee] #tool-grid button{background:#f2b0d8;border-color:#ffe2f3}\0abody.playing[data-theme=blingee] #tool-grid button[aria-pressed=true]{border-style:inset;background:#ce65ad;box-shadow:inset 0 0 0 1px #6c164f}\0a\0a.classic-scroll-shell{display:contents}.classic-scrollbar{display:none}\0a\0a/* Reference-sized Hint / Skip toolbox, in Default\27s cream, green, and coral. */\0abody:not([data-layout=classic]) #round-controls{--hint-art:url(\27data:image/svg+xml;base64,\27);position:relative;display:block;width:87px;height:40px;padding:0;flex:none;background:var(--hint-art) no-repeat}\0abody:not([data-layout=classic]) #round-controls[data-done=true]{--hint-art:url(\27data:image/svg+xml;base64,\27)}\0abody:not([data-layout=classic]) #round-controls button{position:absolute;top:4px;height:30px;margin:0;padding:0;border:0;border-radius:2px;font-size:0;background-image:var(--hint-art);background-color:transparent;background-repeat:no-repeat}\0abody:not([data-layout=classic]) #round-controls #give-hint{left:16px;width:35px;background-position:-16px -4px}\0abody:not([data-layout=classic]) #round-controls #skip{left:54px;width:29px;background-position:-54px -4px;clip-path:polygon(28% 0,72% 0,100% 28%,100% 72%,72% 100%,28% 100%,0 72%,0 28%)}\0abody:not([data-layout=classic]) #round-controls[data-done=true] #skip{clip-path:circle(48% at 50% 50%)}\0abody:not([data-layout=classic]) #round-controls button:hover:not(:disabled){filter:brightness(1.1)}\0abody:not([data-layout=classic]) #round-controls button:active:not(:disabled){filter:brightness(.9)}\0abody:not([data-layout=classic]) #round-controls #give-hint:disabled{filter:grayscale(1);opacity:.7}\0abody:not([data-layout=classic]) #hints-used{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}\0a\0a#settings-dialog{max-width:calc(100vw - 30px)}\0a\0a/* The separate username screen follows the supplied 1280 \c3\97 720 reference. */\0a.connect-route{background:#d5d5d5}.connect-route body{margin:0;background:#d5d5d5;color:#606060;font-family:Verdana,Arial,sans-serif}.connect-route body>header,.connect-route body>footer,.connect-route main>#lobby,.connect-route main>#game{display:none}.connect-route main{padding:0;max-width:none}.connect-route #connect-page{display:block!important}\0a#connect-page{position:fixed;inset:0 19px;border:1px solid #b8b8b8;background:repeating-linear-gradient(0deg,#ffffff16 0 1px,#00000007 1px 2px),linear-gradient(#fdfdfd 0%,#ededed 24%,#ababab 100%);box-shadow:inset 1px 0 #fff,inset -1px 0 #e5e5e5;container-type:inline-size;color:#606060}\0a#connect-logo{position:absolute;left:21.9%;top:10.7%;width:24%;height:auto;filter:drop-shadow(0 1px 1px #0005)}\0a.connect-copy{position:absolute;left:10.75%;top:31.8%;width:46.4%;height:auto;min-height:42.8%;padding:2.2cqw 1.65cqw;border-radius:1.5cqw;background:#ffffff6e;font:1.85cqw/1.15 Verdana,Arial,sans-serif;letter-spacing:-.035cqw;box-shadow:inset 0 1px #ffffff26}.connect-copy p{margin:0 0 1.95cqw}.connect-copy p:last-child{margin:0}\0a#connect-page #profile-form{position:absolute;left:68%;top:43.2%;width:20.65%;height:28.7%;display:flex;flex-direction:column;gap:0;font:1.5cqw/1.05 Verdana,Arial,sans-serif}#connect-page #profile-form label{display:block;margin:0 0 .12cqw;letter-spacing:.02cqw}#connect-page #player-name{display:block;width:100%;height:2.8cqw;min-height:25px;padding:.1cqw .25cqw;border:3px solid;border-color:#858585 #f6f6f6 #f6f6f6 #858585;border-radius:3px;background:#fff;color:#4b4b4b;box-shadow:inset 1px 1px #c5c5c5,0 0 0 1px #b5b5b5;font:1.55cqw Verdana,Arial,sans-serif}#connect-page #player-name:focus{outline:1px solid #777;outline-offset:1px}\0a#connect-submit{align-self:flex-end;margin-top:auto;position:relative;width:8.85cqw;height:2.8cqw;min-width:83px;min-height:29px;padding:0;border:1px solid #96acae;border-radius:2cqw;color:#4b5e62;background:linear-gradient(90deg,#b2cdcf66,#ffffff66 46%,#aac4c966),linear-gradient(#74989e 0%,#aac4c8 17%,#eaf3f3 55%,#d1e4e5 85%,#8ea8ac 100%);box-shadow:inset 0 1px 2px #eefaff,inset 2px 0 3px #577d85,inset -2px 0 3px #5b8086,0 .35cqw .6cqw #0007;font:1.65cqw Verdana,Arial,sans-serif;letter-spacing:.035cqw;text-shadow:0 1px #ffffff90}#connect-submit:hover{filter:brightness(1.06)}#connect-submit:active{transform:translateY(1px);box-shadow:inset 0 2px 4px #507780,0 2px 3px #0006}#connect-submit:focus-visible{outline:2px solid #526f7d;outline-offset:4px}#connect-error{position:absolute;top:100%;left:0;right:0;margin:12px 0 0;font:12px/1.4 Verdana,Arial,sans-serif;color:#742d2d}#connect-error:empty{display:none}\0a.player-summary{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:0 0 23px;font-size:12px;color:var(--muted)}.player-summary p{margin:0}.player-summary a{color:var(--green)}.player-name[role=button]{cursor:pointer}.player-name[role=button]:focus-visible{outline:2px solid var(--green);outline-offset:2px}#player-profile-ship{overflow-wrap:anywhere;font-family:monospace;font-size:13px}\0a@media(max-width:680px){.connect-route #connect-page{inset:0 8px;display:flex!important;flex-direction:column;align-items:center;justify-content:center;gap:20px;padding:24px 18px;overflow:auto}#connect-logo{position:static;width:min(250px,90%);flex:none}.connect-copy{position:static;width:100%;height:auto;min-height:0;padding:19px 17px;border-radius:13px;font:clamp(13px,3.6vw,18px)/1.3 Verdana,Arial,sans-serif;letter-spacing:0}.connect-copy p{margin:0 0 17px}#connect-page #profile-form{position:relative;left:auto;top:auto;width:100%;max-width:340px;height:auto;flex:none;font:16px Verdana,Arial,sans-serif}#connect-page #profile-form label{margin-bottom:4px}#connect-page #player-name{height:34px;padding:2px 5px;font:16px Verdana,Arial,sans-serif}#connect-submit{width:110px;height:35px;margin-top:20px;border-radius:20px;font:20px Verdana,Arial,sans-serif;box-shadow:inset 0 1px 2px #eefaff,inset 2px 0 3px #577d85,
ofile-select{grid-column:1;grid-row:2;max-width:150px}.name-save{display:flex;gap:7px;grid-column:2;grid-row:2}.name-save input{width:160px;font-size:12px}.name-save button{white-space:nowrap;font-size:11px;padding:9px}\0a.lobby-heading{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:24px 0 20px;border-top:1px solid var(--line)}.lobby-heading>div{min-width:0}.lobby-heading>button{flex-shrink:0}.host-bar{display:flex;justify-content:space-between;align-items:center;border:1px solid var(--line);border-radius:6px;background:#edf0e7;padding:12px 16px;margin-bottom:12px;font-size:12px;color:#697b6a}.host-bar form{display:flex;gap:7px}.host-bar input{width:290px;font-size:11px;padding:8px}.host-bar button{padding:8px 12px}.room-list{display:grid;grid-template-columns:repeat(3,1fr);gap:15px;min-height:0}.room-card{padding:18px;border:1px solid var(--line);background:var(--white);border-radius:7px;display:flex;flex-direction:column;gap:14px}.room-card h3{font-size:17px;margin:0;font-weight:500}.room-card p{margin:0;font-size:11px}.card-bottom{display:flex;align-items:center;justify-content:space-between;font:11px monospace}.lobby-footer{display:flex;justify-content:space-between;font:9px monospace;letter-spacing:1px;color:#8c9688;margin:18px 0 30px}body>footer{max-width:1460px;margin:auto;padding:20px 36px;border-top:1px solid var(--line);font-size:11px;color:#8b9687}.footer-star{color:#c9a347;font-size:18px;margin:0 7px}\0a/* On laptops the board and inputs fit the viewport; logs scroll independently. */\0abody.playing{height:100dvh;overflow:hidden;display:flex;flex-direction:column}body.playing header{height:50px;flex:none;padding:0 18px;max-width:none}body.playing .brand{font-size:23px}body.playing .brand-mark{width:29px;height:29px;line-height:29px;font-size:25px}body.playing .brand-mark span{font-size:16px;top:-9px}body.playing main{flex:1;min-height:0;max-width:none;padding:0 14px 12px}body.playing>footer{display:none}#game{height:100%;d
\0a    if(epoch!==roomEpoch)return;\0a    hostPresenceUntil=Date.now()+GRACE_MS;rememberRoom(state.title);\0a    if(heartbeatWarning)toast(\27Room connection restored.\27);\0a    heartbeatWarning=false;\0a  }catch(e){\0a    if(epoch!==roomEpoch)return;\0a    if(Date.now()>=hostPresenceUntil){showLobby();operation(\27join-status\27,`${e.message} Use Rejoin to return.`);}\0a    else if(!heartbeatWarning){heartbeatWarning=true;toast(\27The host is slow to respond. Retrying your room connection\e2\80\a6\27);}\0a  }finally{if(heartbeatInFlight?.epoch===epoch)heartbeatInFlight=null;}\0a}\0asetInterval(()=>{void maintainPresence();},10000);\0adocument.addEventListener(\27visibilitychange\27,()=>{if(!document.hidden)void maintainPresence();});\0awindow.addEventListener(\27pagehide\27,()=>{if(!api.events&&!api.opening)return;const actions=[];if(state&&roomId){saveRecovery(null);actions.push({id:api.next++,action:\27poke\27,ship:SELF.slice(1),app:\27ursketch\27,mark:\27json\27,json:{action:\27leave\27,host,room:roomId,request:`leave-${api.uid}`,name:activeName}});}actions.push({id:api.next++,action:\27delete\27});api.events?.close();fetch(api.url,{method:\27PUT\27,headers:{\27Content-Type\27:\27application/json\27},body:JSON.stringify(actions),keepalive:true}).catch(()=>{});});\0a\0afunction isArtist() { return state?.players[0]?.ship === SELF; }\0afunction canDraw() { return connectionReady && state?.phase === \27drawing\27 && isArtist(); }\0afunction appendRoomMessages(messages){\0a  const key=m=>JSON.stringify([m.who,m.kind,m.text]);\0a  let overlap=Math.min(serverMessages.length,messages.length);\0a  while(overlap&&!serverMessages.slice(-overlap).every((m,i)=>key(m)===key(messages[i])))overlap--;\0a  const fresh=messages.slice(overlap);roomTimeline.push(...fresh);roomTimeline=roomTimeline.slice(-160);serverMessages=messages;\0a  return fresh;\0a}\0afunction renderRoomMessages(){\0a  renderMessages(\27messages\27,roomTimeline.filter(m=>![\27chat\27,\27warning\27,\27kick\27
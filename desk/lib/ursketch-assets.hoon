lly{remove.disabled=false;}});\0a  $(\27player-profile-dialog\27).showModal();\0a}\0afunction installClassicScrollbars(){\0a  for(const id of [\27players\27,\27messages\27,\27chat-messages\27,\27browser-guide\27,\27room-list\27]){\0a    const content=$(id),shell=element(\27div\27,\27classic-scroll-shell\27),rail=element(\27div\27,\27classic-scrollbar\27);\0a    const up=element(\27button\27,\27scroll-up\27),track=element(\27div\27,\27scroll-track\27),thumb=element(\27div\27,\27scroll-thumb\27),down=element(\27button\27,\27scroll-down\27);\0a    up.type=down.type=\27button\27;up.setAttribute(\27aria-label\27,\27Scroll up\27);down.setAttribute(\27aria-label\27,\27Scroll down\27);\0a    thumb.tabIndex=0;thumb.setAttribute(\27role\27,\27scrollbar\27);thumb.setAttribute(\27aria-orientation\27,\27vertical\27);thumb.setAttribute(\27aria-controls\27,id);thumb.setAttribute(\27aria-valuemin\27,\270\27);\0a    content.before(shell);shell.append(content,rail);track.append(thumb);rail.append(up,track,down);\0a    function update(){\0a      if(!rail.offsetHeight)return;\0a      const max=Math.max(0,content.scrollHeight-content.clientHeight),size=Math.min(track.clientHeight,[\27browser-guide\27,\27room-list\27].includes(id)?42:23);\0a      thumb.style.height=size+\27px\27;thumb.style.top=(max?(track.clientHeight-size)*content.scrollTop/max:0)+\27px\27;\0a      thumb.setAttribute(\27aria-valuemax\27,String(max));thumb.setAttribute(\27aria-valuenow\27,String(Math.round(content.scrollTop)));\0a    }\0a    let repeat=null;\0a    function stop(){clearInterval(repeat);repeat=null;}\0a    for(const [button,amount] of [[up,-17],[down,17]]){button.onclick=()=>{content.scrollTop+=amount;};button.onpointerdown=()=>{stop();repeat=setInterval(()=>{content.scrollTop+=amount;},80);};button.onpointerup=stop;button.onpointercancel=stop;button.onpointerleave=stop;}\0a    let drag=null;\0a    thumb.onpointerdown=e=>{e.preventDefault();thumb.focus({preventScroll:true});drag={y:e.clientY,top:content.scrollTop};thumb.setPointerCapture(e.pointerId);};\0a    thumb.onpointermove=e=>{if(!drag)return;const distance=Math.max(1,track.clientHeight-thumb.offsetHeight);content.scrollTop=drag.top+(e.clientY-drag.y)*(content.scrollHeight-content.clientHeight)/distance;};\0a    thumb.onpointerup=thumb.onpointercancel=thumb.onlostpointercapture=()=>{drag=null;};\0a    window.addEventListener(\27blur\27,()=>{stop();drag=null;});\0a    track.onpointerdown=e=>{if(e.target===track){content.scrollTop+=(e.clientY<thumb.getBoundingClientRect().top?-1:1)*content.clientHeight;}};\0a    thumb.onkeydown=e=>{const steps={ArrowUp:-17,ArrowDown:17,PageUp:-content.clientHeight,PageDown:content.clientHeight};if(e.key in steps){e.preventDefault();e.stopPropagation();content.scrollTop+=steps[e.key];}else if(e.key===\27Home\27||e.key===\27End\27){e.preventDefault();e.stopPropagation();content.scrollTop=e.key===\27Home\27?0:content.scrollHeight;}};\0a    content.addEventListener(\27scroll\27,update);new ResizeObserver(update).observe(content);new MutationObserver(update).observe(content,{childList:true,subtree:true,characterData:true});\0a  }\0a}\0afunction syncThemeLayout(){\0a  const classic=document.body.dataset.layout===\27classic\27;\0a  for(const [id,anchor] of [[\27guess-form\27,\27guess-form-home\27],[\27round-controls\27,\27round-controls-home\27]]){\0a    const target=classic?$(\27classic-left-controls\27):$(anchor).parentElement;\0a    if($(id).parentElement!==target){if(classic)target.append($(id));else $(anchor).after($(id));}\0a  }\0a}\0afunction fitCanvas(){const wrap=$(\27canvas\27).parentElement;if(!wrap.clientWidth||!wrap.clientHeight)return;const width=wrap.clientWidth,height=wrap.clientHeight;$(\27canvas\27).style.width=`${width}px`;$(\27canvas\27).style.height=`${height}px`;wrap.style.setProperty(\27--board-left\27,\270px\27);wrap.style.setProperty(\27--board-top\27,\270px\27);wrap.style.setProperty(\27--board-width\27,`${width}px`);drawing?.fit();}\0anew ResizeObserver(fitCanvas).observe($(\27canvas\27).parentElement);\0atry{const saved=JSON.parse(localStorage.getItem(profileKey)||\27null\27);if(saved){profiles=(saved.names||[]).filter(n=>typeof n===\27string\27&&validPlayerName(n));if(profiles.includes(saved.active))activeName=saved.active;}}catch{}\0ainstallClassicScrollbars();\0aconst preferences=createSettings({notify:toast,onChange:prefs=>{if(lastTheme!==prefs.theme){drawing?.resetView();lastTheme=prefs.theme;}gameAudio?.settings();syncThemeLayout();requestAnimationFrame(fitCanvas);}});\0aif(!connectPage)gameAudio=createGameAudio({urls:{"CloseGuess": "/apps/ursketch/media/45ce5ea566101a31/audio/cues/CloseGuess.mp3", "HintNoise": "/apps/ursketch/media/29269f063d4fefaf/audio/cues/HintNoise.mp3", "JoinRoom": "/apps/ursketch/media/f960ddde6b03f9ea/audio/cues/JoinRoom.mp3", "NewRound": "/apps/ursketch/media/192ae75c6062a0a2/audio/cues/NewRound.mp3", "RemindsRules": "/apps/ursketch/media/c8f3b35dec323958/audio/cues/RemindsRules.mp3", "SomeoneElseGotTheWord": "/apps/ursketch/media/c47a746566111b61/audio/cues/SomeoneElseGotTheWord.mp3", "TickingNoise": "/apps/ursketch/media/b573d4be00730331/audio/cues/TickingNoise.mp3", "YouGotTheWord": "/apps/ursketch/media/6a416efa93ae0731/audio/cues/YouGotTheWord.mp3", "YourTurnToDraw": "/apps/ursketch/media/262d70bca42c5ffc/audio/cues/YourTurnToDraw.mp3"},getPrefs:()=>preferences.values,notify:toast});\0aif(!connectPage)finale=createFinale({surface:$(\27canvas\27).parentElement,layer:$(\27game-finale\27),getAudio:()=>gameAudio,getPrefs:()=>preferences.values,onEnd:()=>{if(state?.phase===\27finished\27){state={...state,celebrating:false,remainingMs:0,seconds:0};renderRoom(state);}}});\0arenderProfiles();drawing=createDrawing({canvas:$(\27canvas\27),colors,canDraw,send:(action,data)=>api.poke(action,action===\27draw\27&&roomStream?{encoding:1,lines:data.lines.map(l=>UrSketchWire.pack(l))}:data),error:e=>toast(e.message||String(e)),onDraw:dismissBanner,storageKey:`ursketch.palettes.${SELF}`});restoreRecovery();\0aif(!connectPage)run(async()=>{if(!SELF)throw new Error(\27Open urSketch through your Urbit ship at /apps/ursketch.\27);const query=new URLSearchParams(location.search);restoreKnownHosts();void connectGlobalChat();await browse(query.get(\27host\27)||GLOBAL_CHAT_HOST);void watchOtherHosts();const id=query.get(\27room\27);if(id){if(!savedRoom)saveRecovery({host,id,title:id,expiresAt:Date.now()+GRACE_MS});const restored=[\27reload\27,\27back_forward\27].includes(performance.getEntriesByType(\27navigation\27)[0]?.type);if(restored){history.replaceState(null,\27\27,location.pathname);operation(\27join-status\27,\27Your room tab was restored. Select Rejoin to return.\27);}else await joinRoom(id);}});\0a</script>\0a</body></html>\0a'))
++  intro
  ^-  @t
  '<!doctype html>\0a<html lang="en">\0a<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>urSketch \c2\b7 Play now</title><link rel="icon" type="image/png" sizes="512x512" href="/apps/ursketch/media/ccfc04ad004fad99/images/app-tile.png"><style>:root{font-family:Verdana,Arial,sans-serif;color:#122a3b;--intro-sky:rgb(159,193,224);background:var(--intro-sky)}*{box-sizing:border-box}body{margin:0;min-height:100dvh;display:grid;place-items:center;background:var(--intro-sky)}main{width:100%;display:flex;flex-direction:column;align-items:center;padding:8px}#intro-stage{position:relative;width:min(100%,1620px,calc((100dvh - 78px)*1.5));aspect-ratio:3/2;flex:none;background:var(--intro-sky);isolation:isolate;overflow:hidden;transform:scale(.72);transform-origin:center}#intro-video{display:none}#intro-scene{display:block;width:100%;height:100%}#intro-wordmark{position:absolute;left:56.2962963%;top:.5555556%;width:40.4938272%;height:26.1759259%;object-fit:contain;pointer-events:none}.movie-target{position:absolute;display:block;padding:0;border:0;background:transparent;color:transparent;cursor:pointer;z-index:1;transform:translate(-50%,-50%);text-decoration:none}.movie-target:hover{background:transparent}.movie-target:focus-visible{outline:3px solid #fff;outline-offset:5px;box-shadow:0 0 0 7px #183b5a}#intro-play{left:87.4074%;top:69.6296%;width:21.2346%;height:31.8519%;border-radius:50%;min-width:34px}#intro-instructions{left:87.5%;top:93.0556%;width:22.8395%;height:12.5%;border-radius:8%}#intro-scene,#intro-wordmark{opacity:0}body.art-ready #intro-scene,body.art-ready #intro-wordmark{opacity:1}.intro-settings{position:fixed;right:16px;top:12px;z-index:5;width:40px;height:40px;border:0;border-radius:50%;background:transparent;color:#173b5d;font-size:25px;cursor:pointer}.intro-settings:hover{background:#ffffff40}.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}dialog{width:min(480px,calc(100% - 28px));max-height:calc(100dvh - 28px);overflow:auto;padding:24px;background:#eef5fc;color:#132f48;border:2px solid #4f7495;border-radius:5px;font-size:13px;line-height:1.6}dialog h1{font-size:22px;margin-top:0}dialog::backdrop{background:#102333b3}dialog button{font:inherit;cursor:pointer;padding:7px 10px;border:1px solid #4f7495;border-radius:4px;background:#d3e4f1;color:#132f48}dialog button:hover{background:#eaf3fb}button:focus-visible,input:focus-visible,select:focus-visible{outline:3px solid #183b5a;outline-offset:3px}#settings-dialog{width:min(440px,calc(100% - 28px))}.settings-heading{display:flex;justify-content:space-between;align-items:center;gap:12px}.settings-heading h2{font-size:22px;margin:0}.settings-heading button{font-size:20px;border:0;background:transparent}fieldset{border:1px solid #91aec7;border-radius:4px;padding:12px;margin:16px 0}legend{font-weight:bold;padding:0 5px}#settings-dialog label{display:block;margin:9px 0 5px}.settings-check{display:flex!important;gap:8px;align-items:center}.settings-check input{margin:0;width:auto}#sound-volume{width:100%;accent-color:#2d649a}#volume-value{float:right}select{width:100%;padding:7px;border:1px solid #91aec7;background:#fff;color:#132f48}.output-controls{display:flex;gap:6px;align-items:center}.output-controls select{min-width:0;flex:1}.output-controls button{white-space:nowrap;padding:7px}.settings-note,#audio-status{font-size:11px;line-height:1.5}#intro-fallback{color:#132f48;font-weight:bold;padding:8px;position:fixed;bottom:12px}#intro-fallback[hidden]{display:none}@media(max-width:600px){main{padding:4px}#intro-stage{width:min(100%,calc((100dvh - 110px)*1.5))}.intro-settings{right:8px;top:8px}dialog{padding:18px}}@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto}}\0a</style></head>\0a<body>\0a<button id="settings-open" class="intro-settings" aria-label="Settings" title="Settings">\e2\9a\99</button>\0a<main aria-label="urSketch introduction">\0a  <div id="intro-stage">\0a    <video id="intro-video" muted playsinline loop preload="none" poster="/apps/ursketch/media/3cd27feef6be5d8c/images/intro-poster.jpg" aria-hidden="true"></video>\0a    <canvas id="intro-scene" width="1620" height="1080" aria-hidden="true"></canvas>\0a    <svg width="0" height="0" aria-hidden="true" style="position:absolute"><defs>\0a      <filter id="logo-alpha-cleanup"><feComponentTransfer><feFuncA type="linear" slope="1.066667" intercept="-.066667"/></feComponentTransfer></filter>\0a    </defs></svg>\0a    <img id="intro-wordmark" src="/apps/ursketch/media/53160c12c3b4aa4d/images/ursketch-logo.png" alt="urSketch">\0a    <a id="intro-play" class="movie-target" href="/apps/ursketch/connect" aria-label="Play now"><span class="sr-only">Play now</span></a>\0a    <button id="intro-instructions" class="movie-target" aria-label="Instructions"><span class="sr-only">Instructions</span></button>\0a  </div>\0a  <p id="intro-status" class="sr-only" role="status" aria-live="polite">Loading animation\e2\80\a6</p>\0a  <a id="intro-fallback" href="/apps/ursketch/connect" hidden>Play now \e2\86\92</a>\0a</main>\0a<dialog id="settings-dialog" aria-labelledby="settings-heading"><div class="settings-heading"><h2 id="settings-heading">Settings</h2><button id="settings-close" class="quiet" aria-label="Close settings">\e2\9c\95</button></div>\0a <fieldset><legend>Sound</legend><label class="settings-check"><input id="sound-muted" type="checkbox">Mute sound</label><label for="sound-volume">Volume <output id="volume-value">70%</output></label><input id="sound-volume" type="range" min="0" max="100" value="70"><label for="audio-output">Output device</label><div class="output-controls"><select id="audio-output"><option value="">System default</option></select><button id="choose-output" type="button">Choose output\e2\80\a6</button></div><p id="audio-status" role="status">Choose where game sounds will play.</p><button id="test-sound" type="button">Test sound</button></fieldset>\0a <fieldset><legend>Theme song</legend><label class="settings-check"><input id="theme-song-quarter" type="checkbox">Theme song at 25% volume</label><label class="settings-check"><input id="theme-song-disabled" type="checkbox">Disable theme song</label><p class="settings-note">25% uses one quarter of the normal theme-song level, after the master volume above.</p></fieldset>\0a <fieldset><legend>Appearance & accessibility</legend><label for="theme-select">Theme</label><select id="theme-select"><option value="classic">Classic</option><option value="blingee">Blingee</option><option value="grubbery" disabled>Grubbery Theme \e2\80\94 coming soon</option></select><label class="settings-check"><input id="reduce-motion" type="checkbox">Reduce motion</label><label class="settings-check"><input id="large-chat" type="checkbox">Larger chat text</label></fieldset><button id="settings-reset" class="quiet" type="button">Restore defaults</button><p class="settings-note">Saved in this browser.</p></dialog>\0a<dialog id="intro-help"><h1>How to play</h1><p>Choose Play now to create a room or search a friend\27s ship. Each player plays through their own ship.</p><p>Take turns choosing a secret word and drawing it in 80 seconds. Guess the artist\27s word in Game; use Chat to talk. No letters or numbers in the drawing.</p><p>Correct guesses earn 10, 9, 8, 7, 6, then 5 points each. The artist earns 10 points for the first correct guess, plus one for each additional guesser.</p><p>Give hint can be used three times before the first correct guess. It shows the letter count, then reveals one random letter per press. The artist\27s initial reward becomes 5, 4, then 3 points. With no correct guesses, the artist earns no points.</p><p>Drawing shortcuts: Pen P, Brush B, Spray Y, Eraser E, Rectangle S, Circle C, Line L, Zoom Z. +/\e2\88\92 zoom; double-click Zoom to reset; Space pans.</p><form method="dialog"><button>Back to intro</button></form></dialog>\0a<noscript><p>JavaScript is needed to play urSketch. <a href="/apps/ursketch/connect">Open the lobby</a>.</p></noscript>\0a<script>/* Browser-local preferences and the audio output used by game sounds. */\0afunction createSettings({notify,onChange}) {\0a  const $=id=>document.getElementById(id),key=\27ursketch.settings.v1\27;\0a  const defaults={theme:\27classic\27,volume:70,muted:false,output:\27\27,reduceMotion:false,largeChat:false,themeQuiet:false,themeDisabled:false};\0a  function readPrefs(){\0a    const next={...defaults};\0a    try{const saved=JSON.parse(localStorage.getItem(key)||\27null\27);if(saved){\0a      next.theme=[\27classic\27,\27blingee\27].includes(saved.theme)?saved.theme:\27classic\27;\0a      next.volume=Number.isFinite(saved.volume)?Math.max(0,Math.min(100,saved.volume)):70;\0a      for(const name of [\27muted\27,\27reduceMotion\27,\27largeChat\27,\27themeQuiet\27,\27themeDisabled\27])next[name]=saved[name]===true;\0a      next.output=typeof saved.output===\27string\27?saved.output:\27\27;\0a    }}catch{}\0a    return next;\0a  }\0a  let prefs=readPrefs();\0a  const audio=new Audio();audio.preload=\27auto\27;\0a  let toneUrl=null;\0a  function apply(){\0a    document.body.dataset.theme=prefs.theme;document.body.dataset.layout=\27classic\27;\0a    document.body.classList.toggle(\27reduce-motion\27,prefs.reduceMotion);\0a    document.body.classList.toggle(\27large-chat\27,prefs.largeChat);\0a    audio.volume=prefs.volume/100;audio.muted=prefs.muted;\0a    $(\27theme-select\27).value=prefs.theme;$(\27sound-volume\27).value=prefs.volume;$(\27volume-value\27).value=prefs.volume+\27%\27;\0a    $(\27sound-muted\27).checked=prefs.muted;$(\27reduce-motion\27).checked=prefs.reduceMotion;$(\27large-chat\27).checked=prefs.largeChat;\0a    $(\27theme-song-quarter\27).checked=prefs.themeQuiet;$(\27theme-song-disabled\27).checked=prefs.themeDisabled;\0a    onChange?.({...prefs});\0a  }\0a  function save(){try{localStorage.setItem(key,JSON.stringify(prefs));}catch{}apply();}\0a  function message(text)
pcm=buffer.getChannelData(channel);let low=0;\0a          for(let i=0;i<pcm.length;i++){\0a            const t=i/rate,n=noise();low=low*.96+n*.04;\0a            const boom=low*Math.exp(-t*5)*(1-Math.exp(-t*180))*2;\0a            const crackle=n*Math.pow(Math.max(0,1-t/2.4),2)*(Math.sin(t*(91+variant*13))>.88?.13:.012);\0a            pcm[i]=Math.max(-.7,Math.min(.7,boom+crackle));\0a          }\0a        }\0a        fireworkBuffers.push(buffer);\0a      }\0a    }\0a    source(\27Fireworks\27,undefined,null,fireworkBuffers[index%fireworkBuffers.length]);\0a  }\0a  function stopFireworks(){for(const voice of [...voices])if(voice.urSketchCue===\27Fireworks\27)stopVoice(voice);}\0a  function stop(){deadline=0;tickKey=null;tickDone=true;stopTicks();for(const voice of [...voices])stopVoice(voice);}\0a  document.addEventListener(\27pointerdown\27,unlock,{passive:true});document.addEventListener(\27keydown\27,unlock);\0a  window.addEventListener(\27pagehide\27,()=>{stop();disposed=true;clearInterval(ticker);void context?.close();output?.pause();});\0a  ticker=setInterval(schedule,25);\0a  return {play,countdown,settings,stop,firework,stopFireworks,get context(){return context;},get master(){return master;},get ready(){return loading;},get loaded(){return [...buffers.keys()];}};\0a}\0a\0a/* The host owns the 40-second deadline; local particles never travel over Ames. */\0afunction createFinale({surface,layer,getAudio,getPrefs,onEnd}){\0a  const sky=layer.querySelector(\27canvas\27),ctx=sky.getContext(\272d\27,{alpha:false});\0a  let key=null,start=0,end=0,frame=null,live=false,bursts=[],heard=new Set();\0a  const completed=new Set();\0a  const colours=[\27#fff7d1\27,\27#ffffff\27,\27#e7d5ff\27,\27#ffcb68\27,\27#adceff\27,\27#ffb9cc\27];\0a  function random(seed){return()=>{seed=(Math.imul(seed,1664525)+1013904223)>>>0;return seed/4294967296;};}\0a  function stop(){live=false;key=null;cancelAnimationFrame(frame);frame=null;layer.hidden=true;getAudio()?.stopFireworks();}\0a  function paint(now){\0a    frame=null;if(!live)return;if(now>=end){completed.add(key);if(completed.size>64)completed.delete(completed.values().next().value);stop();onEnd?.();return;}\0a    const box=surface.getBoundingClientRect(),ratio=Math.min(2,devicePixelRatio||1),w=Math.max(1,Math.round(box.width*ratio)),h=Math.max(1,Math.round(box.height*ratio));\0a    if(sky.width!==w||sky.height!==h){sky.width=w;sky.height=h;}\0a    ctx.fillStyle=\27#000\27;ctx.fillRect(0,0,w,h);\0a    const seconds=(now-start)/1000,reduced=getPrefs().reduceMotion;\0a    for(const burst of bursts){\0a      const age=seconds-burst.time;if(age<0||age>3.5)continue;\0a      if(!heard.has(burst.id)){heard.add(burst.id);if(age<.25&&!document.hidden)getAudio()?.firework(burst.id);}\0a      if(reduced)continue;\0a      for(const particle of burst.particles){\0a        const life=Math.max(0,1-age/particle.life);if(!life)continue;\0a        const drag=(1-Math.exp(-age*1.15))/1.15;\0a        const x=(burst.x+particle.vx*drag)*w,y=(burst.y+particle.vy*drag+age*age*.026)*h;\0a        ctx.globalAlpha=Math.pow(life,1.3)*(.8+.2*Math.sin(age*31+particle.twinkle));ctx.strokeStyle=particle.colour;ctx.lineWidth=Math.max(.8,ratio*.9);\0a        ctx.beginPath();ctx.moveTo(x-particle.vx*w*.025*life,y-(particle.vy+age*.052)*h*.025*life);ctx.lineTo(x,y);ctx.stroke();ctx.fillStyle=particle.colour;ctx.fillRect(x,y,Math.max(1,ratio*.8),Math.max(1,ratio*.8));\0a      }\0a    }\0a    ctx.globalAlpha=1;frame=requestAnimationFrame(paint);\0a  }\0a  function update(data,identity){\0a    if(completed.has(identity))return;\0a    if(!data?.celebrating||!data.winner){if(live)stop();return;}\0a    const remaining=Math.min(40000,Math.max(0,data.remainingMs??data.seconds*1000));\0a    if(!remaining){if(live)stop();return;}\0a    if(identity!==key){\0a      stop();key=identity;live=true;end=performance.now()+remaining;start=end-40000;heard=new Set();\0a      const rand=random(0x63757273);bursts=[];\0a      for(let i=0;i<32;i++){\0a        const time=.15+i*1.22+(i%5===3?.2:0),x=.13+rand()*.74,y=.16+rand()*.47,colour=colours[i%colours.length];\0a        const particles=Array.from({length:200},()=>{const angle=rand()*Math.PI*2,speed=.07+rand()*.19;return{vx:Math.cos(angle)*speed,vy:Math.sin(angle)*speed,life:1.9+rand()*1.6,twinkle:rand()*Math.PI*2,colour:rand()<.7?\27#fff8e9\27:colour};});\0a        bursts.push({id:i,time,x,y,particles});\0a      }\0a    }else end=Math.min(end,performance.now()+remaining);\0a    layer.hidden=false;layer.querySelector(\27.finale-winner\27).textContent=data.winner.name;\0a    layer.querySelector(\27.finale-score\27).textContent=`with ${data.winner.score} points!`;\0a    layer.querySelector(\27.finale-winner\27).classList.toggle(\27long-name\27,data.winner.name.length>20);\0a    if(frame===null)frame=requestAnimationFrame(paint);\0a  }\0a  document.addEventListener(\27visibilitychange\27,()=>{if(live&&frame===null)frame=requestAnimationFrame(paint);});\0a  window.addEventListener(\27pagehide\27,stop);\0a  return{update,stop,get active(){return live;}};\0a}\0a\0a/* urSketch: native Eyre channels, no JavaScript dependencies. */\0a\27use strict\27;\0aconst $ = id => document.getElementById(id);\0aconst SELF = window.URSKETCH_SHIP;\0aconst GLOBAL_CHAT_HOST="~livbec-pitsyd-botryp-hoshec--faltec-lavtel-firrup-marzod";\0aconst connectPage = document.documentElement.classList.contains(\27connect-route\27);\0a$(\27connect-page\27).hidden=!connectPage;\0aif(connectPage)document.title=\27urSketch \c2\b7 Connect\27;else document.body.classList.add(\27browsing\27);\0alet activeName = SELF, profiles = [];\0aconst profileKey = `ursketch.players.${SELF}`;\0alet host = SELF, roomId = \27\27, state = null, lobbySub = null, roomSub = null;\0alet drawing;\0alet finale=null,gameAudio=null,roomTimeline=[],serverMessages=[],feedbackSeen=new Set(),selectedChat=\27game\27,lastTheme=\27\27,bannerDismissed=null;\0alet clockAt = 0, clockSeconds = 0, connectionReady = false;\0aconst ctx = $(\27canvas\27).getContext(\272d\27);\0a// Swatch centers sampled from the supplied palette reference; black/white are exact.\0aconst colors = [\0a  [\27#0b02f1\27,\27Blue\27],[\27#20712c\27,\27Dark green\27],[\27#f5bb1c\27,\27Gold\27],[\27#f50c08\27,\27Red\27],[\27#6c1dd1\27,\27Violet\27],[\27#7e043f\27,\27Maroon\27],[\27#490007\27,\27Dark brown\27],[\27#000000\27,\27Black\27],\0a  [\27#139cec\27,\27Azure\27],[\27#02a005\27,\27Green\27],[\27#f5f229\27,\27Yellow\27],[\27#e53f29\27,\27Orange-red\27],[\27#cb0069\27,\27Magenta\27],[\27#e0ba96\27,\27Peach\27],[\27#883e31\27,\27Brown\27],[\27#828280\27,\27Gray\27],\0a  [\27#8cbaee\27,\27Light blue\27],[\27#02f102\27,\27Lime\27],[\27#fffa85\27,\27Light yellow\27],[\27#fe9c3b\27,\27Orange\27],[\27#e67287\27,\27Pink\27],[\27#f3ccbd\27,\27Light peach\27],[\27#ba7b58\27,\27Tan\27],[\27#ffffff\27,\27White\27]\0a];\0afunction toast(message) { $(\27toast\27).textContent = message; $(\27toast\27).hidden = false; clearTimeout(toast.timer); toast.timer = setTimeout(() => $(\27toast\27).hidden = true, 4500); }\0afunction connection(text, good) { $(\27status\27).textContent = text; $(\27status-dot\27).classList.toggle(\27connected\27, good); connectionReady = good; renderPlayerTotal(); chatControls(); }\0afunction element(tag, className, text) { const el = document.createElement(tag); if (className) el.className = className; if (text != null) el.textContent = text; return el; }\0afunction rejectedAction(action){\0a  const detail={join:\27The room may be full or no longer available.\27,guess:\27The drawing turn may have changed, or you have already guessed correctly.\27,hint:\27Only the artist can give hints, before the first correct guess and up to three times.\27,draw:\27The drawing turn may have changed or its command limit was reached.\27,start:\27The room owner can start the first game when at least two players are present. Later games start automatically.\27,skip:\27Only the current artist can end this drawing turn.\27,chat:\27The message may contain the secret word.\27,heartbeat:\27Your membership may have expired. Use Rejoin to return.\27,warn:\27Both players must still be in the room.\27,kick:\27Only the room owner can remove another player who is still in the room.\27, \27global-chat\27:\27Messages must be at most 240 bytes and at least one second apart.\27};\0a  return new Error(\27The host could not accept this action. \27+(detail[action]||\27Check your room connection and try again.\27));\0a}\0aclass Eyre {\0a  constructor(){this.uid=`${Date.now()}-${crypto.randomUUID()}`;this.next=1;this.handlers=new Map();this.subscriptions=new Map();this.waiters=new Map();this.requests=new Map();this.url=`/~/channel/ursketch-${this.uid}`;this.opening=null;}\0a  async send(action){\0a    const id=this.next++;let response;\0a    try{response=await fetch(this.url,{method:\27PUT\27,headers:{\27Content-Type\27:\27application/json\27},body:JSON.stringify([{id,...action}]),signal:AbortSignal.timeout(15000)});}\0a    catch(error){if(error.name===\27TimeoutError\27||error.name===\27AbortError\27)throw new Error(\27Your ship did not respond within 15 seconds. Check the connection and room before retrying; the action may still have arrived.\27);throw error;}\0a    if(!response.ok)throw new Error(response.status===403?\27Log into your ship, then reload this page.\27:`Your ship returned HTTP ${response.status}.`);return id;\0a  }\0a  ensure(){if(this.events&&this.events.readyState!==EventSource.CLOSED)return Promise.resolve();if(this.opening)return this.opening;this.opening=this.open().finally(()=>this.opening=null);return this.opening;}\0a  async open(){\0a    await this.send({action:\27poke\27,ship:SELF.slice(1),app:\27hood\27,mark:\27helm-hi\27,json:\27urSketch connected\27});\0a    this.events=new EventSource(this.url);\0a    this.events.onopen=()=>connection(`Connected as ${SELF}`,true);\0a    this.events.onerror=()=>connection(\27Reconnecting to your ship\e2\80\a6\27,false);\0a    this.events.onmessage=event=>{\0a      const data=JSON.parse(event.data);\0a      this.send({action:\27ack\27,\27event-id\27:Number(event.lastEventId)}).catch(()=>{});\0a      const subscription=this.subscriptions.get(data.id);\0a      if(data.response===\27diff\27){\0a        try{const ready=this.handlers.get(data.id)?.(data.json);if(ready!==false)subscription?.ready();}catch(e){subscription?.fail(e);}\0a      }\0a      if((data.response===\27subscribe\27&&data.err)||data.response===\27quit\27){\0a        const message=new Error(data.err?\27The host could not open that room or room list.\27:\27The host stopped sending updates.\27);\0a        subscription?.fail(message);\0a        if(subscription?.settled&&data.response===\27quit\27)subscriptionLost(data.id,message);\0a      }\0a      const waiter=this.waiters.get(data.id);\0a      if(waiter&&data.response===\27poke\27){\0a        if(waiter.remote&&!data.err)return;\0a        this.finish(waiter,data.err?rejectedAction(waiter.action):null);\0a      }\0a    };\0a    await this.subscribe(\27/relay\27,data=>{const waiter=this.requests.get(data.request);if(waiter)this.finish(waiter,data.ok?null:rejectedAction(waiter.action));},false,SELF);\0a  }\0a  finish(waiter,error){clearTimeout(waiter.timer);this.waiters.delete(waiter.id);this.requests.delete(waiter.request);error?waiter.reject(error):waiter.resolve();}\0a  poke(action,data={},target={host,room:roomId}){\0a    const id=this.next,request=`${this.uid}-${id}`;\0a    const result=new Promise((resolve,reject)=>{\0a      const waiter={id,request,action,resolve,reject,remote:target.host!==SELF};\0a      waiter.timer=setTimeout(()=>this.finish(waiter,new Error(\27The host did not respond. You can try again.\27)),20000);\0a      this.waiters.set(id,waiter);if(waiter.remote)this.requests.set(request,waiter);\0a      this.send({action:\27poke\27,ship:SELF.slice(1),app:\27ursketch\27,mark:\27json\27,json:{action,room:target.room,host:target.host,request,name:activeName,token:state?.token||0,...data}}).catch(e=>this.finish(waiter,e));\0a    });\0a    return result;\0a  }\0a  subscribe(path,handler,initial=false,targetHost=host){\0a    const id=this.next,localPath=targetHost===SELF?path:`/proxy/${targetHost}${path}`;\0a    let resolve,reject;\0a    const first=initial?new Promise((yes,no)=>{resolve=yes;reject=no;}):null;\0a    const meta={settled:!initial,ready:()=>{if(meta.settled)return;meta.settled=true;clearTimeout(meta.timer);resolve(id);},fail:e=>{if(meta.settled)return;meta.settled=true;clearTimeout(meta.timer);this.handlers.delete(id);this.subscriptions.delete(id);this.send({action:\27unsubscribe\27,subscription:id}).catch(()=>{});reject(e);}};\0a    if(initial)meta.timer=setTimeout(()=>meta.fail(new Error(\27No room data arrived from the host. Please try again.\27)),20000);\0a    this.handlers.set(id,handler);this.subscriptions.set(id,meta);\0a    const sent=this.send({action:\27subscribe\27,ship:SELF.slice(1),app:\27ursketch\27,path:localPath});\0a    if(initial){sent.catch(meta.fail);return first;}\0a    return sent.then(()=>id).catch(e=>{this.handlers.delete(id);this.subscriptions.delete(id);throw e;});\0a  }\0a  async unsubscribe(id){if(id==null)return;const sub=this.subscriptions.get(id);if(sub&&!sub.settled)sub.fail(new Error(\27Search cancelled.\27));this.handlers.delete(id);this.subscriptions.delete(id);await this.send({action:\27unsubscribe\27,subscription:id});}\0a}\0a// A restored lobby must recreate subscriptions after pagehide closes its channel.\0awindow.addEventListener(\27pageshow\27,event=>{if(event.persisted&&!connectPage)location.reload();});\0aconst api=new Eyre();\0aconst recoveryKey=`ursketch.room.${SELF}`,GRACE_MS=120000;\0alet savedRoom=null,browsing=false,joining=false,searchEpoch=0,roomEpoch=0;\0alet heartbeatInFlight=null,hostPresenceUntil=0,heartbeatWarning=false;\0alet roomStream=false,snapshotRequest=null;\0alet searchMode=\27host\27;\0aconst searchDrafts={host:SELF,invite:\27\27};\0afunction setSearchMode(mode){\0a  searchDrafts[searchMode]=$(\27host\27).value;searchMode=mode;\0a  const invite=mode===\27invite\27;\0a  for(const [id,active] of [[\27search-host-mode\27,!invite],[\27search-invite-mode\27,invite]]){const tab=$(id);tab.setAttribute(\27aria-selected\27,String(active));tab.tabIndex=active?0:-1;}\0a  $(\27host-form\27).setAttribute(\27aria-labelledby\27,invite?\27search-invite-mode\27:\27search-host-mode\27);\0a  $(\27search-label\27).textContent=invite?\27Room invite code\27:\27Browse a host ship\27;\0a  $(\27host\27).placeholder=invite?\27Paste your room invite code or link\27:\27Search a ship\e2\80\a6\27;\0a  $(\27host\27).value=searchDrafts[mode];\0a}\0a$(\27search-host-mode\27).onclick=()=>setSearchMode(\27host\27);$(\27search-invite-mode\27).onclick=()=>setSearchMode(\27invite\27);\0afor(const id of [\27search-host-mode\27,\27search-invite-mode\27])$(id).onkeydown=event=>{if([\27ArrowLeft\27,\27ArrowRight\27,\27Home\27,\27End\27].includes(event.key)){event.preventDefault();const mode=event.key===\27Home\27?\27host\27:event.key===\27End\27?\27invite\27:searchMode===\27host\27?\27invite\27:\27host\27;setSearchMode(mode);$(mode===\27host\27?\27search-host-mode\27:\27search-invite-mode\27).focus();}};\0afunction operation(id,text,busy=false){const el=$(id);el.textContent=text;el.classList.toggle(\27is-busy\27,busy);el.setAttribute(\27aria-label\27,text+(busy?\27\e2\80\a6\27:\27\27));}\0afunction busyControls(){const busy=browsing||joining;$(\27host-search\27).disabled=busy;$(\27host\27).disabled=joining;$(\27search-host-mode\27).disabled=busy;$(\27search-invite-mode\27).disabled=busy;$(\27create-open\27).disabled=busy;for(const b of $(\27room-list\27).querySelectorAll(\27button\27))b.disabled=busy||b.dataset.full===\27true\27;$(\27rejoin-room\27).disabled=busy;$(\27leave-saved-room\27).disabled=busy;}\0afunction saveRecovery(record){savedRoom=record;try{record?localStorage.setItem(recoveryKey,JSON.stringify(record)):localStorage.removeItem(recoveryKey);}catch{}renderRecovery();}\0afunction rememberRoom(title){if(!roomId)return;saveRecovery({host,id:roomId,title:title||state?.title||savedRoom?.title||roomId,expiresAt:Date.now()+GRACE_MS});}\0afunction renderRecovery(){const visible=!!savedRoom&&!state;$(\27room-recovery\27).hidden=!visible;if(!visible)return;const seconds=Math.max(0,Math.ceil((savedRoom.expiresAt-Date.now())/1000));$(\27recovery-title\27).textContent=savedRoom.title;$(\27recovery-detail\27).textContent=`On ${savedRoom.host} \c2\b7 Rejoin available for ${Math.floor(seconds/60)}:${String(seconds%60).padStart(2,\270\27)}`;}\0afunction restoreRecovery(){savedRoom=null;try{const r=JSON.parse(localStorage.getItem(recoveryKey)||\27null\27);if(r&&/^~[a-z-]+$/.test(r.host)&&/^[a-z0-9-]{1,40}$/.test(r.id)&&Number.isFinite(r.expiresAt))savedRoom=r;}catch{}renderRecovery();}\0afunction showLobby({keepRoom=true}={}){const old=roomSub;roomEpoch++;if(snapshotRequest){clearTimeout(snapshotRequest.timer);snapshotRequest=null;}roomId=\27\27;state=null;roomSub=null;finale?.stop();gameAudio?.stop();roomTimeline=[];serverMessages=[];feedbackSeen.clear();if(old!=null)api.unsubscribe(old).catch(()=>{});drawing?.cancel();$(\27game\27).hidden=true;$(\27lobby\27).hidden=false;document.body.classList.remove(\27playing\27,\27is-artist\27,\27is-guesser\27);history.replaceState(null,\27\27,location.pathname);if(!keepRoom)saveRecovery(null);renderRecovery();}\0aconst knownHostsKey=`ursketch.hosts.${SELF}`,knownHosts=new Map();\0alet hideFull=false,hideEmpty=false;\0atry{const saved=JSON.parse(localStorage.getItem(\27ursketch.roomFilters\27)||\27{}\27);hideFull=saved.full===true;hideEmpty=saved.empty===true;}catch{}\0a$(\27hide-full-rooms\27).checked=hideFull;$(\27hide-empty-rooms\27).checked=hideEmpty;\0afunction saveRoomFilters(){hideFull=$(\27hide-full-rooms\27).checked;hideEmpty=$(\27hide-empty-rooms\27).checked;try{localStorage.setItem(\27ursketch.roomFilters\27,JSON.stringify({full:hideFull,empty:hideEmpty}));}catch{}renderRoomList();}\0a$(\27hide-full-rooms\27).onchange=$(\27hide-empty-rooms\27).onchange=saveRoomFilters;\0afunction rememberHost(ship){\0a  if(!knownHosts.has(ship)){if(knownHosts.size>=20){const removable=[...knownHosts].find(([key])=>key!==SELF&&key!==host);if(removable){api.unsubscribe(removable[1].id).catch(()=>{});knownHosts.delete(removable[0]);}}knownHosts.set(ship,{id:null,data:null,pending:null});}\0a  try{localStorage.setItem(knownHostsKey,JSON.stringify([...knownHosts.keys()]));}catch{}\0a  return knownHosts.get(ship);\0a}\0afunction renderPlayerTotal(){\0a  const ships=new Set();let reachable=0,legacy=0;\0a  for(const entry of knownHosts.values()){\0a    if(!entry.data)continue;reachable++;\0a    for(const room of entry.data.rooms){if(Array.isArray(room.players)){for(const player of room.players)ships.add(player.ship);}else legacy=Math.max(legacy,room.count);}\0a  }\0a  const total=Math.max(ships.size,legacy),label=$(\27browser-player-total\27);\0a  label.textContent=connectionReady&&reachable?`Rooms (${legacy?\27\e2\89\a5\27:\27\27}${total} players)`:\27Rooms (\e2\80\a6 players)\27;\0a  label.title=`Distinct players across ${reachable} reachable known host ship${reachable===1?\27\27:\27s\27} (${knownHosts.size} known).`+(legacy?\27 Some hosts do not provide player IDs, so this is a minimum.\27:\27\27);\0a}\0aasync function watchHost(ship){\0a  const entry=rememberHost(ship);if(entry.id!==null)return entry.id;if(entry.pending)return entry.pending;\0a  entry.pending=api.subscribe(\27/lobby\27,data=>{if(knownHosts.get(ship)!==entry)return;if(data.kind!==\27lobby\27||!Array.isArray(data.rooms))throw new Error(\27The host did not return a room list.\27);entry.data=data;renderPlayerTotal();if(host===ship)renderLobby(data);},true,ship)\0a    .then(id=>{if(knownHosts.get(ship)!==entry){void api.unsubscribe(id);return id;}entry.id=id;return id;}).catch(error=>{entry.data=null;renderPlayerTotal();throw error;}).finally(()=>entry.pending=null);\0a  return entry.pending;\0a}\0afunction restoreKnownHosts(){\0a  let saved=[];try{saved=JSON.parse(localStorage.getItem(knownHostsKey)||\27[]\27);}catch{}\0a  for(const ship of Array.isArray(saved)?saved.slice(-19):[])if(/^~[a-z-]+$/.test(ship))rememberHost(ship);\0a  rememberHost(SELF);\0a}\0aasync function watchOtherHosts(){await Promise.allSettled([...knownHosts.keys()].filter(ship=>ship!==host).map(watchHost));}\0a\0afunction subscriptionLost(id,error){\0a  if(id===globalChatSub){globalChatSub=null;globalChatReady=false;chatStatus(\27Chat disconnected. Retry.\27,true);chatControls();}\0a  if(id===roomSub){showLobby();operation(\27join-status\27,`${error.message} Use Rejoin to return.`);toast(\27Room connection lost. Your place is held for up to two minutes.\27);}\0a  for(const [ship,entry] of knownHosts){if(entry.id!==id)continue;entry.id=null;entry.data=null;renderPlayerTotal();if(ship===host)operation(\27browse-status\27,\27Room search disconnected. Search again to retry.\27);}\0a}\0aasync function browse(ship){\0a  if(!/^~[a-z-]+$/.test(ship))throw new Error(\27Enter an Urbit ship name beginning with ~.\27);\0a  if(roomId)throw new Error(\27Leave your current room before searching another host.\27);\0a  const epoch=++searchEpoch;browsing=true;host=ship;searchDrafts.host=ship;\0a  operation(\27browse-status\27,\27Searching\27,true);operation(\27join-status\27,\27\27);listedRooms=[];renderRoomList();busyControls();\0a  try{\0a    await api.ensure();const id=await watchHost(ship);\0a    if(epoch!==searchEpoch)return;lobbySub=id;renderLobby(knownHosts.get(ship).data);if(searchMode===\27host\27)$(\27host\27).value=\27\27;\0a  }catch(e){if(epoch===searchEpoch)operation(\27browse-status\27,\27Search failed. Please try again.\27);throw e;}\0a  finally{if(epoch===searchEpoch){browsing=false;busyControls();renderRoomList();}}\0a}\0alet listedRooms=[];\0afunction renderRoomList(){renderRoomCards(listedRooms);}\0afunction renderLobby(data){\0a  if(data?.kind!==\27lobby\27)return;\0a  operation(\27browse-status\27,\27\27);\0a  $(\27browse-status\27).title=$(\27browse-status\27).textContent;listedRooms=data.rooms;renderRoomList();\0a}\0afunction renderRoomCards(rooms){\0a  const list=$(\27room-list\27),shown=rooms.filter(r=>!(hideFull&&r.count>=10)&&!(hideEmpty&&r.count===0));list.hidden=false;\0a  if(!shown.length){list.replaceChildren(element(\27p\27,\27browser-empty\27,browsing?\27Searching\e2\80\a6\27:rooms.length?\27No rooms match your filters.\27:\27None found\27));return;}\0a  list.replaceChildren(...shown.map(r=>{\0a    const row=element(\27article\27,`room-row${r.count?\27 occupied\27:\27\27}`),rejoin=savedRoom?.host===host&&savedRoom?.id===r.id,full=r.count>=10&&!rejoin;\0a    const button=element(\27button\27,\27room-name\27,r.title);button.dataset.full=String(full);button.disabled=full||browsing||joining;button.onclick=()=>run(()=>joinRoom(r.id,r.title));button.title=`${r.title}\5cn${r.phase} \c2\b7 ${r.count}/10 players\5cnHosted by ${host}`;\0a    const count=element(\27span\27,\27room-occupancy\27,`${r.count}/10`);count.tabIndex=0;count.title=Array.isArray(r.players)?r.players.map(p=>`${p.name||p.ship} (${p.ship})`).join(\27\5cn\27)||\27No players yet\27:`${r.count} players`;\0a    const details=element(\27div\27,\27room-details\27);details.append(element(\27b\27,\27\27,r.title),element(\27p\27,\27\27,`Phase: ${r.phase}`),element(\27p\27,\27\27,`Players: ${r.count}/10`));\0a    row.append(button,count,details);return row;\0a  }));\0a}\0alet globalChatSub=null,globalChatOpening=null,globalChatReady=false,globalChatSending=false,globalMessages=[];\0afunction chatStatus(text,retry=false){$(\27global-chat-status\27).textContent=text;$(\27global-chat-retry\27).hidden=!retry;}\0afunction chatControls(){const disabled=!globalChatReady||globalChatSending||!connectionReady;$(\27global-chat-input\27).disabled=disabled;$(\27global-chat-send\27).disabled=disabled;}\0afunction renderGlobalChat(data){\0a  if(data.kind!==\27global-chat\27||!Array.isArray(data.messages))throw new Error(\27Chat data unavailable.\27);\0a  const guide=$(\27browser-guide\27),atBottom=guide.scrollHeight-guide.scrollTop-guide.clientHeight<60,first=globalMessages.length===0;\0a  globalMessages=data.messages;globalChatReady=true;chatStatus(\27\27);chatControls();\0a  $(\27global-messages\27).replaceChildren(...globalMessages.map(message=>{\0a    const row=element(\27p\27,\27global-message\27),name=element(\27button\27,\27global-chat-name\27,message.name||message.ship);name.type=\27button\27;name.title=message.ship;name.onclick=()=>inspectPlayer(message);\0a    row.append(name,document.createTextNode(\27: \27+message.text));return row;\0a  }));\0a  if(atBottom||first&&globalMessages.length)requestAnimationFrame(()=>guide.scrollTop=guide.scrollHeight);\0a}\0aasync function connectGlobalChat(){\0a  if(globalChatOpening)return globalChatOpening;if(globalChatSub!==null)return;\0a  globalChatOpening=(async()=>{chatStatus(\27Connecting\e2\80\a6\27);try{await api.ensure();globalChatSub=await api.subscribe(\27/global-chat\27,renderGlobalChat,true,GLOBAL_CHAT_HOST);}catch{globalChatReady=false;chatStatus(\27Chat unavailable. Retry.\27,true);chatControls();}finally{globalChatOpening=null;}})();\0a  return globalChatOpening;\0a}\0a$(\27global-chat-retry\27).onclick=()=>{void connectGlobalChat();};\0a$(\27global-chat-form\27).onsubmit=async event=>{\0a  event.preventDefault();const input=$(\27global-chat-input\27),text=input.value.trim();if(!text||!globalChatReady||globalChatSending)return;\0a  if(new TextEncoder().encode(text).length>240||/[\5cu0000-\5cu001f\5cu007f]/.test(text)){chatStatus(\27Please shorten your message.\27);return;}\0a  globalChatSending=true;chatControls();\0a  try{await api.poke(\27global-chat\27,{text},{host:GLOBAL_CHAT_HOST,room:\27\27});if(input.value.trim()===text)input.value=\27\27;chatStatus(\27\27);}\0a  catch{chatStatus(\27Message not sent. Please try again.\27);}\0a  finally{globalChatSending=false;chatControls();if(!input.disabled)input.focus();}\0a};\0afunction requestDrawingSnapshot(){\0a  if(snapshotRequest?.epoch===roomEpoch)return;\0a  const epoch=roomEpoch;\0a  const request={epoch,timer:setTimeout(()=>{if(snapshotRequest===request){snapshotRequest=null;toast(\27Drawing updates are delayed. Rejoin if the connection does not recover.\27);}},20000)};\0a  snapshotRequest=request;\0a  api.poke(\27sync\27).catch(e=>{if(snapshotRequest===request){clearTimeout(request.timer);snapshotRequest=null;toast(e.message);}});\0a}\0afunction roomEvent(data){\0a  if(state&&Number.isInteger(data.token)&&data.token<state.token)return null;\0a  if(data.kind===\27feedback\27){\0a    if(data.feedback===\27close\27&&state?.phase===\27drawing\27&&data.room===roomId&&data.token===state.token&&!feedbackSeen.has(data.id)){\0a      feedbackSeen.add(data.id);if(feedbackSeen.size>100)feedbackSeen.delete(feedbackSeen.values().next().value);\0a      roomTimeline.push({who:\27\27,text:data.text,kind:\27close\27});roomTimeline=roomTimeline.slice(-160);renderRoomMessages();void gameAudio?.play(\27CloseGuess\27);\0a    }\0a    return null;\0a  }\0a  if(data.kind===\27draw\27){\0a    if(!state){requestDrawingSnapshot();return null;}\0a    if(data.token<state.token)return null;\0a    if(data.token!==state.token){requestDrawingSnapshot();return null;}\0a    if(data.count<=state.lines.length)return null;\0a    if(data.from!==state.lines.length||data.count!==data.from+data.lines.length){requestDrawingSnapshot();return null;}\0a    state.lines.push(...data.lines.map(l=>UrSketchWire.unpack(l)));state.count=data.count;state.seconds=data.seconds;state.remainingMs=data.remainingMs;\0a    clockSeconds=(data.remainingMs??data.seconds*1000)/1000;clockAt=performance.now();\0a    gameAudio?.countdown(state.finishing?clockSeconds*1000:null,`${host}/${roomId}/${state.token}`);\0a    drawing.render(state.lines,state.token);updateDial();\0a    return null;\0a  }\0a  if(data.kind===\27state\27){\0a    if(state&&data.token===state.token&&data.count===state.lines.length)return {...data,kind:\27room\27,lines:state.lines};\0a    if(data.count===0)return {...data,kind:\27room\27,lines:[]};\0a    requestDrawingSnapshot();return null;\0a  }\0a  if(data.kind===\27room\27){\0a    if(snapshotRequest){clearTimeout(snapshotRequest.timer);snapshotRequest=null;}\0a    return {...data,lines:data.encoding===1?data.lines.map(l=>UrSketchWire.unpack(l)):data.lines};\0a  }\0a  return data;\0a}\0aasync function joinRoom(id,title=\27\27){\0a  if(joining)throw new Error(\27A room is already opening.\27);\0a  const recovering=savedRoom?.id===id&&savedRoom?.host===host;\0a  const epoch=++roomEpoch;let firstView=true;\0a  finale?.stop();gameAudio?.stop();roomTimeline=[];serverMessages=[];feedbackSeen.clear();\0a  joining=true;roomId=id;state=null;operation(\27join-status\27,`Joining ${title||id}`,true);busyControls();\0a  let accepted=false;\0a  try{\0a    await api.ensure();await api.poke(\27join\27);accepted=true;hostPresenceUntil=Date.now()+GRACE_MS;heartbeatWarning=false;rememberRoom(title);\0a    await api.unsubscribe(roomSub);roomSub=null;\0a    const receive=data=>{\0a      if(epoch!==roomEpoch)return false;\0a      data=roomEvent(data);if(!data)return false;\0a      if(data.kind===\27removed\27||(data.kind===\27room\27&&!data.players.some(p=>p.ship===SELF))){const kicked=data.messages?.some(m=>m.kind===\27kick\27&&m.ship===SELF);saveRecovery(null);if(kicked)toast(\27The room owner removed you. You can join again when you choose.\27);if(firstView)throw new Error(\27That room is no longer available.\27);localLeave();operation(\27join-status\27,\27Your place in that room has ended.\27);return false;}\0a      if(data.kind!==\27room\27)throw new Error(\27The host did not return a room.\27);\0a      firstView=false;renderRoom(data);return true;\0a    };\0a    roomStream=true;\0a    try{roomSub=await api.subscribe(`/stream/${id}/${SELF}`,receive,true);}\0a    catch(e){\0a      if(!/host could not open|host stopped sending/.test(e.message))throw